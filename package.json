{
  "name": "mosslight-rpg-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "test": "node --test tests/*.test.js",
    "art": "node tools/export-art.mjs",
    "test:e2e": "node tests/browser.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src/*.js src/*.css tests index.html",
    "benchmark": "node tools/benchmark.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "vite": "6.4.5"
  }
}
